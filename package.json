{
  "name": "mortgage-affordability-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/cli.ts samples/halifax/test-case-1.json",
    "samples": "npm run build && node scripts/run-samples.mjs",
    "api": "tsx src/server.ts",
    "attached:browser": "powershell -ExecutionPolicy Bypass -File scripts/start-attached-browser.ps1",
    "map:halifax": "tsx src/map-halifax.ts input.yaml samples/halifax-mapped-from-input.json",
    "map:halifax:cases": "npm run build && node scripts/map-halifax-raw-cases.mjs",
    "map:barclays": "tsx src/map-barclays.ts input.yaml samples/barclays-mapped-from-input.json",
    "map:barclays:cases": "npm run build && node scripts/map-barclays-raw-cases.mjs",
    "map:skipton": "tsx src/map-skipton.ts input.yaml samples/skipton-mapped-from-input.json",
    "map:skipton:cases": "npm run build && node scripts/map-skipton-raw-cases.mjs",
    "map:virgin-money": "tsx src/map-virgin-money.ts input.yaml samples/virgin-money-mapped-from-input.json",
    "map:virgin-money:cases": "npm run build && node scripts/map-virgin-money-raw-cases.mjs",
    "map:hsbc": "tsx src/map-hsbc.ts input.yaml samples/hsbc-mapped-from-input.json",
    "map:hsbc:cases": "npm run build && node scripts/map-hsbc-raw-cases.mjs",
    "map:natwest": "tsx src/map-natwest.ts input.yaml samples/natwest-mapped-from-input.json",
    "map:natwest:cases": "npm run build && node scripts/map-natwest-raw-cases.mjs",
    "map:kensington": "tsx src/map-kensington.ts input.yaml samples/kensington-mapped-from-input.json",
    "map:kensington:cases": "npm run build && node scripts/map-kensington-raw-cases.mjs",
    "map:santander": "tsx src/map-santander.ts input.yaml samples/santander-mapped-from-input.json",
    "map:santander:cases": "npm run build && node scripts/map-santander-raw-cases.mjs",
    "map:nationwide": "tsx src/map-nationwide.ts input.yaml samples/nationwide-mapped-from-input.json",
    "map:nationwide:cases": "npm run build && node scripts/map-nationwide-raw-cases.mjs",
    "start": "node dist/server.js",
    "start:cli": "node dist/cli.js samples/halifax/test-case-1.json",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/**/*.test.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "playwright": "^1.45.3",
    "yaml": "^2.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
