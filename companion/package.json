{
  "name": "mortgage-ofc-companion",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test link.test.cjs updater.test.cjs",
    "pack:win": "electron-builder --config electron-builder.config.cjs --publish never --win nsis",
    "pack:mac": "electron-builder --config electron-builder.config.cjs --publish never --mac dmg zip",
    "pack:linux": "electron-builder --config electron-builder.config.cjs --publish never --linux AppImage deb"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "playwright": "1.59.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "uk.co.mortgageaffordability.ofc",
    "productName": "Open Filled Calculator",
    "files": [
      "main.cjs",
      "link.cjs",
      "updater.cjs",
      "preload.cjs",
      "status.html",
      "dist/**/*",
      "package.json"
    ],
    "protocols": [
      {
        "name": "Open Filled Calculator",
        "schemes": [
          "ofc"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    }
  }
}
